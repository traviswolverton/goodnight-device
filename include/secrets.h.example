// Copy this file to secrets.h (gitignored — never commit real credentials)
// and fill in real values. secrets.h is included directly by main.cpp.

#pragma once

// For real hardware, your actual WiFi. For Wokwi simulation, use
// "Wokwi-GUEST" with an empty password instead — Wokwi's simulated ESP32
// only joins that network (it's how its WiFi reaches the internet at
// all), so real SSID/password here would just fail to connect in-sim.
#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Dedicated Mosquitto broker on the homelab LAN (see desk-dashboard-server
// repo's DESIGN.md) — not the public internet, and not Home Assistant's
// broker. Read-only "esp32-client" account per that repo's ACL config.
#define MQTT_HOST     "mosquitto.your-homelab.lan"
#define MQTT_PORT     1883
#define MQTT_USERNAME "esp32-client"
#define MQTT_PASSWORD "your-esp32-client-password"

// OTA firmware updates (see ota.cpp) -- without this, anything on the
// LAN could push firmware to the board over its OTA port. Pick your own
// password; it's unrelated to the MQTT one above. The same value also
// needs to be set as a shell env var (OTA_PASSWORD) when actually
// running an OTA upload -- see DESIGN.md's "OTA firmware updates"
// section for why it lives in two places.
#define OTA_PASSWORD "your-ota-password"
