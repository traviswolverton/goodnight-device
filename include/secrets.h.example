// Copy this file to secrets.h (gitignored — never commit real credentials)
// and fill in real values. secrets.h is included directly by main.cpp.

#pragma once

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Where to ask for broker settings: bedside-dashboard-server's address
// (plain http, its LAN address and port, no trailing slash) and the device
// token made on its Connections page (Bedside device -> Device token). With
// these two set, the broker below is only the starting point: the server's
// answer replaces it, so moving the device to another broker is done on
// that page, not by reflashing. Leave them out to use MQTT_* below only.
#define SERVER_URL   "http://192.0.2.20:8001"
#define DEVICE_TOKEN "paste-the-token-from-the-connections-page"

// The homelab's central MQTT broker, shared with Home Assistant and the
// desk dashboard. The bedside-esp32 account there may touch only the
// device's own bedside/* topics (bedside-dashboard-server's
// docs/mqtt-broker.md has its ACL). Used until the server first answers
// (and whenever it never has).
#define MQTT_HOST     "192.0.2.10"
#define MQTT_PORT     1883
#define MQTT_USERNAME "bedside-esp32"
#define MQTT_PASSWORD "your-bedside-esp32-password"

// OTA firmware updates (see ota.cpp) -- without this, anything on the
// LAN could push firmware to the board over its OTA port. Pick your own
// password; it's unrelated to the MQTT one above. The same value also
// needs to be set as a shell env var (OTA_PASSWORD) when actually
// running an OTA upload (see platformio.ini's esp32dev-ota env).
#define OTA_PASSWORD "your-ota-password"
